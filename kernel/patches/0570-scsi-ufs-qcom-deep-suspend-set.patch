+
 		if (ufs_qcom_cfg_timers(hba, false, ULONG_MAX)) {
 			dev_err(hba->dev, "%s: ufs_qcom_cfg_timers() failed\n",
 				__func__);
@@ -738,6 +748,12 @@ static int ufs_qcom_link_startup_notify(struct ufs_hba *hba,
 		err = ufshcd_disable_host_tx_lcc(hba);
 
